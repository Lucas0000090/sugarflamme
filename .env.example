# Clés PUBLIQUES du SDK RevenueCat (Project settings → API keys → « Public app-specific API keys »).
# Pour un test local : copie ce fichier en `.env.local` (non versionné) et remplis les valeurs.
# Pour les builds EAS : crée les mêmes variables avec `npx eas-cli@latest env:create` (voir PUBLICATION.md).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
